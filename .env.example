# Скопируйте в .env.local и подставьте свои значения. .env.local в git не попадает.

# Публичный адрес сайта — для метатегов и sitemap.
# На Vercel можно не задавать: возьмётся адрес продакшен-деплоя.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Контакты на сайте. WhatsApp — номер в международном формате без «+» и пробелов.
NEXT_PUBLIC_CONTACT_PHONE="+996 312 000 000"
NEXT_PUBLIC_WHATSAPP_NUMBER=996312000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@joldosh.example

# Заявки с сайта уходят письмом через Resend (resend.com → API Keys).
# Без ключа локально форма работает, а заявка выводится в консоль сервера.
# BOOKING_EMAIL_TO — почта, с которой вы зарегистрированы в Resend: пока у сайта
# нет своего домена, Resend отправляет письма только на неё
RESEND_API_KEY=
BOOKING_EMAIL_TO=
# Отправитель по умолчанию — тестовый адрес Resend; свой появится после подключения домена
# BOOKING_EMAIL_FROM="Joldosh <bookings@your-domain.kg>"

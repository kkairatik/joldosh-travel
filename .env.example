# Скопируйте в .env.local и подставьте свои значения. .env.local в git не попадает.

# Публичный адрес сайта — для метатегов и sitemap.
# На Vercel можно не задавать: возьмётся адрес продакшен-деплоя.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Контакты на сайте. WhatsApp — номер в международном формате без «+» и пробелов.
NEXT_PUBLIC_CONTACT_PHONE="+996 312 000 000"
NEXT_PUBLIC_WHATSAPP_NUMBER=996312000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@joldosh.example
